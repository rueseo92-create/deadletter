# ═══════════════════════════════════════════
# AI 브리핑 — Environment Variables
# ═══════════════════════════════════════════

# Google AdSense
NEXT_PUBLIC_ADSENSE_ID=ca-pub-XXXXXXXXXX

# Firebase Admin SDK (Vercel Environment Variables에 설정)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# Admin
ADMIN_TOKEN=your-admin-token
NEWSLETTER_ADMIN_KEY=your-newsletter-admin-key

# ISR Revalidation
REVALIDATION_TOKEN=your-revalidation-token

# Optional: Webhooks
# NEWSLETTER_WEBHOOK_URL=https://hooks.zapier.com/xxx
# INQUIRY_WEBHOOK_URL=https://hooks.zapier.com/xxx
